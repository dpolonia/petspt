# Copiar para .env e preencher com valores reais
# NÃO comitar o ficheiro .env preenchido

# ─── Ambiente ───────────────────────────────────────────
# development | production
# Em development: tier Intenso nunca é usado (downgrade automático para Moderado)
PETSPT_ENV=development

# ─── API dados.gov.pt ──────────────────────────────────
# Obter em https://dados.gov.pt/pt/
DADOS_GOV_API_KEY=

# ─── Firebase ───────────────────────────────────────────
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=petspt.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=petspt
VITE_FIREBASE_STORAGE_BUCKET=petspt.appspot.com

# ─── AI & Research (Sprint 5) ──────────────────────────
SCOPUS_API_KEY=
AI_MODEL_KEY=

# ─── LLM Cost Governance ──────────────────────────────
# Custo máximo semanal em APIs LLM (USD). Ao atingir, chamadas são bloqueadas.
MAX_WEEKLY_LLM_COST_USD=20

# Cost metadata por provider/tier (USD por 1M tokens)
# OpenAI
OPENAI_COST_INTENSO_INPUT_USD_PER_1M=30
OPENAI_COST_INTENSO_OUTPUT_USD_PER_1M=180
OPENAI_COST_MODERADO_INPUT_USD_PER_1M=2.5
OPENAI_COST_MODERADO_OUTPUT_USD_PER_1M=15
OPENAI_COST_BAIXO_INPUT_USD_PER_1M=0.25
OPENAI_COST_BAIXO_OUTPUT_USD_PER_1M=2
# Anthropic
ANTHROPIC_COST_INTENSO_INPUT_USD_PER_1M=5
ANTHROPIC_COST_INTENSO_OUTPUT_USD_PER_1M=25
ANTHROPIC_COST_MODERADO_INPUT_USD_PER_1M=3
ANTHROPIC_COST_MODERADO_OUTPUT_USD_PER_1M=15
ANTHROPIC_COST_BAIXO_INPUT_USD_PER_1M=1
ANTHROPIC_COST_BAIXO_OUTPUT_USD_PER_1M=5
# Vertex AI
VERTEX_COST_INTENSO_INPUT_USD_PER_1M=7
VERTEX_COST_INTENSO_OUTPUT_USD_PER_1M=21
VERTEX_COST_MODERADO_INPUT_USD_PER_1M=0.075
VERTEX_COST_MODERADO_OUTPUT_USD_PER_1M=0.3
VERTEX_COST_BAIXO_INPUT_USD_PER_1M=0.075
VERTEX_COST_BAIXO_OUTPUT_USD_PER_1M=0.3
