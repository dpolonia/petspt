rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Cache é público para leitura, escrita apenas por Cloud Functions
    match /cache/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /contratos_programa/{document=**} {
      allow read: if true;
      allow write: if false;
    }
    match /ai_summaries/{document=**} {
      allow read: if true;
      allow write: if false;
    }
  }
}
